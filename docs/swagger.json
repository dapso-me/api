                },
                "position": {
                    "type": "integer"
                },
                "project_id": {
                    "type": "string"
                },
                "translations": {
                    "description": "key is lang_code",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            }
