    "definitions": {
        "account_handler.changePasswordReq": {
            "type": "object",
            "properties": {
                "current_password": {
                    "type": "string",
                    "example": "qwerty123"
                },
                "new_password": {
                    "type": "string",
                    "example": "321ytrewq"
                }
            }
        },
        "account_handler.signInReq": {
            "type": "object",
            "properties": {
                "password": {
                    "type": "string",
                    "example": "qwerty123"
                },
                "username": {
                    "type": "string",
                    "example": "john_doe"
                }
            }
        },
        "application.AuthOutput": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
