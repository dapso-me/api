        "project.Project": {
            "type": "object",
            "properties": {
                "ID": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "customer_id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "removed_at": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                }
            }
        },
        "project_handler.addProjectReq": {
            "type": "object",
            "properties": {
                "customer_id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "slug": {
                    "type": "string"
                }
